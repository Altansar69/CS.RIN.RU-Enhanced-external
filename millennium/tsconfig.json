{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "declaration": false,
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "typeRoots": [
      "./.millennium/types",
      "./node_modules/@types"
    ],
    "paths": {
      "millennium": [
        "./.millennium/lsp/webkit-ts"
      ]
    }
  },
  "include": [
    "webview/**/*.ts",
    ".millennium/**/*.d.ts"
  ]
}